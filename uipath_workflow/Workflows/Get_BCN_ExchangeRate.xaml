    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Get BCN Exchange Rate" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="soapBody" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:String)" Name="soapHeaders" />
      <Variable x:TypeArguments="uwahm:HttpResponseSummary" Name="bcnResponse" />
    </Sequence.Variables>
    <Assign DisplayName="Assign soapBody (RecuperaTC_Dia)" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[soapBody]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[String.Format("&lt;?xml version=""1.0"" encoding=""utf-8""?&gt;&lt;soap:Envelope xmlns:soap=""http://schemas.xmlsoap.org/soap/envelope/""&gt;&lt;soap:Body&gt;&lt;RecuperaTC_Dia xmlns=""http://servicios.bcn.gob.ni/""&gt;&lt;Ano&gt;{0}&lt;/Ano&gt;&lt;Mes&gt;{1}&lt;/Mes&gt;&lt;Dia&gt;{2}&lt;/Dia&gt;&lt;/RecuperaTC_Dia&gt;&lt;/soap:Body&gt;&lt;/soap:Envelope&gt;", in_IssueDate.Year, in_IssueDate.Month, in_IssueDate.Day)]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Assign soapHeaders (SOAPAction)" sap2010:WorkflowViewState.IdRef="Assign_2">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:Dictionary(x:String, x:String)">[soapHeaders]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)">[New Dictionary(Of String, String) From {{"SOAPAction", """http://servicios.bcn.gob.ni/RecuperaTC_Dia"""}}]</InArgument>
      </Assign.Value>
    </Assign>
    <uwah:NetHttpRequest DisplayName="HTTP Request BCN RecuperaTC_Dia" sap2010:WorkflowViewState.IdRef="NetHttpRequest_1" AuthenticationType="None" ContinueOnError="False" Headers="[soapHeaders]" Method="POST" RequestBodyType="Text" RequestUrl="[in_Config(&quot;BcnServiceUrl&quot;).ToString]" Result="[bcnResponse]" RetryPolicyType="None" TextPayload="[soapBody]" TextPayloadContentType="text/xml" TextPayloadEncoding="UTF-8">
      <uwah:NetHttpRequest.TimeoutInMiliseconds>
        <InArgument x:TypeArguments="s:Nullable(x:Int32)">[Convert.ToInt32(in_Config("BcnTimeoutMs"), CultureInfo.InvariantCulture)]</InArgument>
      </uwah:NetHttpRequest.TimeoutInMiliseconds>
    </uwah:NetHttpRequest>
    <If DisplayName="If BCN did not answer 200 OK" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Condition>
        <InArgument x:TypeArguments="x:Boolean">[bcnResponse Is Nothing OrElse bcnResponse.StatusCode &lt;&gt; HttpStatusCode.OK]</InArgument>
      </If.Condition>
      <If.Then>
        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <Throw DisplayName="Throw SE-01 (BCN unavailable)" sap2010:WorkflowViewState.IdRef="Throw_1">
            <Throw.Exception>
              <InArgument x:TypeArguments="s:Exception">[New Exception("SE-01: El servicio BCN no respondio 200 OK. Estado: " &amp; If(bcnResponse Is Nothing, "sin respuesta", bcnResponse.StatusCode.ToString))]</InArgument>
            </Throw.Exception>
          </Throw>
        </Sequence>
      </If.Then>
    </If>
    <Assign DisplayName="Assign out_ExchangeRate" sap2010:WorkflowViewState.IdRef="Assign_3">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Decimal">[out_ExchangeRate]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Decimal">[Decimal.Parse(XDocument.Parse(bcnResponse.TextContent).Descendants().First(Function(e) e.Name.LocalName = "RecuperaTC_DiaResult").Value, CultureInfo.InvariantCulture)]</InArgument>
      </Assign.Value>
    </Assign>
    <If DisplayName="If the rate is not positive" sap2010:WorkflowViewState.IdRef="If_2">
      <If.Condition>
        <InArgument x:TypeArguments="x:Boolean">[out_ExchangeRate &lt;= 0D]</InArgument>
      </If.Condition>
      <If.Then>
        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_3">
          <Throw DisplayName="Throw SE-01 (invalid rate)" sap2010:WorkflowViewState.IdRef="Throw_2">
            <Throw.Exception>
              <InArgument x:TypeArguments="s:Exception">[New Exception("SE-01: El BCN devolvio una tasa no valida para " &amp; in_IssueDate.ToString("yyyy-MM-dd"))]</InArgument>
            </Throw.Exception>
          </Throw>
        </Sequence>
      </If.Then>
    </If>
    <ui:LogMessage DisplayName="Log exchange rate" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[String.Format(CultureInfo.InvariantCulture, &quot;Tasa BCN {0:yyyy-MM-dd}: {1:0.0000}&quot;, in_IssueDate, out_ExchangeRate)]" />
  </Sequence>
</Activity>
