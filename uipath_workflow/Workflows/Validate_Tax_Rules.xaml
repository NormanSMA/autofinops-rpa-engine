    <ui:InvokeCode DisplayName="Apply RF-05 tax rules" sap2010:WorkflowViewState.IdRef="InvokeCode_1" Code="Dim exempt As Boolean = False&#xA;providerName = providerNamePdf&#xA;costCenter = &quot;Sin clasificar&quot;&#xA;status = &quot;CONCILIADA&quot;&#xA;errorCode = &quot;&quot;&#xA;notes = &quot;&quot;&#xA;If dt_Provider.Rows.Count &gt; 0 Then&#xA;  providerName = dt_Provider.Rows(0)(&quot;legal_name&quot;).ToString()&#xA;  costCenter = dt_Provider.Rows(0)(&quot;cost_center&quot;).ToString()&#xA;  Dim exemptRaw As String = dt_Provider.Rows(0)(&quot;is_tax_exempt&quot;).ToString().Trim()&#xA;  exempt = exemptRaw = &quot;1&quot; OrElse exemptRaw.Equals(&quot;true&quot;, StringComparison.OrdinalIgnoreCase) OrElse exemptRaw.Equals(&quot;t&quot;, StringComparison.OrdinalIgnoreCase)&#xA;End If&#xA;Dim expectedIva As Decimal = If(exempt, 0D, Math.Round(subtotal * ivaRate, 2, MidpointRounding.AwayFromZero))&#xA;If dt_Duplicate.Rows.Count &gt; 0 Then&#xA;  status = &quot;RECHAZADA_DUPLICADA&quot;&#xA;  errorCode = &quot;BRE-03&quot;&#xA;  notes = &quot;BRE-03: La factura &quot; &amp; invoiceNumber &amp; &quot; ya existe para el RUC indicado.&quot;&#xA;ElseIf dt_Provider.Rows.Count = 0 Then&#xA;  status = &quot;OBSERVADA_REGLA_NEGOCIO&quot;&#xA;  errorCode = &quot;BRE-01&quot;&#xA;  notes = &quot;BRE-01: El RUC no existe en el catalogo de proveedores autorizados.&quot;&#xA;ElseIf Math.Abs(subtotal + iva - total) &gt; tolerance OrElse Math.Abs(iva - expectedIva) &gt; tolerance Then&#xA;  status = &quot;OBSERVADA_REGLA_NEGOCIO&quot;&#xA;  errorCode = &quot;BRE-02&quot;&#xA;  notes = String.Format(System.Globalization.CultureInfo.InvariantCulture, &quot;BRE-02: El IVA cobrado ({0:0.00}) no coincide con el {1:0}% legal ({2:0.00}). Enviado a revision humana.&quot;, iva, ivaRate * 100D, expectedIva)&#xA;Else&#xA;  notes = If(exempt, &quot;Proveedor exento de IVA.&quot;, &quot;IVA 15% validado.&quot;)&#xA;End If&#xA;Dim subtotalNio As Decimal = If(currency = &quot;USD&quot;, subtotal * rate, subtotal)&#xA;Dim totalNio As Decimal = If(currency = &quot;USD&quot;, total * rate, total)&#xA;irNio = 0D&#xA;If status = &quot;CONCILIADA&quot; AndAlso Not exempt AndAlso subtotalNio &gt; threshold Then&#xA;  irNio = Math.Round(subtotalNio * irRate, 2, MidpointRounding.AwayFromZero)&#xA;  notes = notes &amp; &quot; Retencion IR 2% aplicada.&quot;&#xA;End If&#xA;netNio = Math.Round(totalNio - irNio, 2, MidpointRounding.AwayFromZero)&#xA;netUsd = Math.Round(netNio / rate, 2, MidpointRounding.AwayFromZero)">
