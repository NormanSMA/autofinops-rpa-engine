# Copia este archivo a infra/.env y reemplaza cada placeholder.
# infra/.env esta ignorado por git. No subas valores reales.

# PostgreSQL 17
POSTGRES_USER=<usuario_postgres>
POSTGRES_PASSWORD=<contrasena_postgres>
POSTGRES_DB=autofinops_db
POSTGRES_PORT=5432

# pgAdmin 4
PGADMIN_EMAIL=<correo_admin@example.com>
PGADMIN_PASSWORD=<contrasena_pgadmin>
PGADMIN_PORT=5050

# Metabase
METABASE_PORT=3001

# Buzon de prueba GreenMail (IMAP del Dispatcher)
MAIL_USER=facturas
MAIL_PASSWORD=<contrasena_buzon_prueba>
MAIL_DOMAIN=autofinops.test
MAIL_SMTP_PORT=3025
MAIL_IMAP_PORT=3143
